{
  /* Workbench configuration */
  "workbench.colorTheme": "Wal Bordered",
  "workbench.preferredLightColorTheme": "Subaru (Light)",
  "workbench.preferredDarkColorTheme": "Wal Bordered",
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "Tabler",
  "workbench.activityBar.location": "top",
  "workbench.navigationControl.enabled": false,
  "workbench.browser.showInTitleBar": true,
  "window.autoDetectColorScheme": true,

  /* Editor configuration */
  "editor.fontSize": 16,
  "editor.fontFamily": "'CaskaydiaCove Nerd Font Mono'",
  "editor.fontWeight": "400",
  "editor.formatOnPaste": true,
  "editor.mouseWheelZoom": true,
  "editor.wordWrap": "on",
  "editor.inlayHints.padding": true,
  "editor.cursorBlinking": "phase",
  "editor.wrapOnEscapedLineFeeds": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "underline",
  "editor.smoothScrolling": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.lineNumbers": "relative",
  "workbench.list.smoothScrolling": true,

  /* Terminal configuration */
  "terminal.integrated.initialHint": false,
  "terminal.integrated.smoothScrolling": true,
  "terminal.external.linuxExec": "alacritty",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.sendKeybindingsToShell": true,

  /* File Explorer configuration */
  "explorer.confirmDelete": false,
  "notebook.output.wordWrap": true,
  "notebook.lineNumbers": "on",
  "notebook.formatOnSave.enabled": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 5000,

  /* GitHub Copilot configuration */
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "jsonc": true,
    "json": true,
  },
  "github.copilot.nextEditSuggestions.eagerness": "auto",
  "github.copilot.chat.anthropic.thinking.enabled": true,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "chat.mcp.gallery.enabled": true,
  "chat.fontSize": 14,
  "chat.useAgentSkills": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.checkpoints.showFileChanges": true,
  "chat.agentsControl.enabled": false,
  "chat.editing.explainChanges.enabled": true,
  "chat.restoreLastPanelSession": true,
  "chat.viewProgressBadge.enabled": true,
  "chat.viewSessions.enabled": false,
  "chat.useNestedAgentsMdFiles": true,

  /* Python configuration */
  "python.languageServer": "Pylance",
  "python.analysis.aiHoverSummaries": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.autoFormatStrings": true,
  "python.analysis.cacheLSPData": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.generateWithTypeAnnotation": true,
  "python.analysis.languageServerMode": "full",
  "python.testing.pytestEnabled": true,
  "pylint.showNotifications": "always",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "jupyter.askForKernelRestart": false,
  "jupyter.themeMatplotlibPlots": true,

  /* ESLint configuration */
  "eslint.format.enable": true,
  "vs-code-prettier-eslint.prettierLast": true,

  /* Git configuration */
  "git.autorefresh": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",

  /* Add more settings as needed */
}

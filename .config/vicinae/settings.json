{
   "$schema": "https://vicinae.com/schemas/config.json",
   "pop_to_root_on_close": true,
   "keybinding": "default",
   "font": {
      "rendering": "native",
      "normal": {
         "family": "ComicShannsMono Nerd Font Propo",
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "evergarden-winter",
         "icon_theme": "WhiteSur"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "opacity": 0.9,
      "client_side_decorations": {
         "enabled": true
      }
   },
   "favorites": [
      "applications:AppFlowy"
   ],
   "providers": {
      "applications": {
         "entrypoints": {
            "Alacritty": {
               "alias": "terminal"
            },
            "AppFlowy": {
               "alias": "notes"
            },
            "antigravity": {
               "enabled": true
            },
            "brave-browser": {
               "alias": "browser"
            },
            "brave-cinhimbnkkaeohfgghhklpknlkffjgod-Default": {

[{
    "output":["eDP-1","HDMI-A-1"],
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "reload_style_on_change": true,
    "include": ["~/.config/waybar/modules.jsonc"],
    "modules-left": [
      "hyprland/window",
      "group/utils"
    ],
    
    "modules-center": [
      "custom/updates",
      "hyprland/workspaces",
      "custom/notifications"
      
    ],
  
    "modules-right": [
      "group/tools",
      "network",
      "bluetooth",
      "backlight",
      "pulseaudio",
      "group/power",
      "clock"
    ]
},
{
    "name": "overlay",
    "height": 45,
    "width": 300,
    "layer": "bottom",
    "position": "bottom", 
    "margin-bottom": -51,
    "mode": "overlay",

    "modules-center": ["custom/cava"],
    "custom/cava": {
        "format": "{}",
        "exec": "~/.scripts/cava.sh"
    },
},
{
    "output":["eDP-1","HDMI-A-1"],
    "layer": "top",
    "position": "bottom",
    "fixed-center": true,
    "reload_style_on_change": true,
    "include": ["~/.config/waybar/modules.jsonc"],
    "modules-left": [
      "wlr/taskbar",
      "custom/cpucat"
    ],

    "modules-center": [
      "custom/playerinfo"
    ],

    "modules-right": [
      "group/control-center",
      "custom/weather",
      "group/sys"
    ]
}]
